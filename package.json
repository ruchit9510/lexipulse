{
  "name": "daily-vocabulary-app",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Daily Vocabulary Learning App with Google Drive Sync",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
