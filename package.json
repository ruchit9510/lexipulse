  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "mongoose": "^9.10.1",
    "xlsx": "^0.18.5"
  }
}
